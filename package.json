{
  "name": "follow-up-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "A simple, focused Obsidian calendar for dated #follow-up tasks.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "deploy:local": "node scripts/deploy-local.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
